<?xml version="1.0"?>
<info>
    <id>outside_provider_calendar_bridge</id>
    <name>Calendar Bridge</name>
    <summary>Bridge external calendar providers into Nextcloud</summary>
    <description><![CDATA[Calendar Bridge keeps Nextcloud calendars in sync with external providers (currently Google Calendar). Forked from MarcelRobitaille/nextcloud_google_synchronization; not compatible with the upstream Google integration app.]]></description>
    <version>4.1.3</version>
    <licence>agpl</licence>
    <author>Marcel Robitaille</author>
    <author>Alex DiMarco</author>
    <namespace>CalendarBridge</namespace>
    <documentation>
        <developer>https://github.com/alexdimarco/nextcloud-google-sync</developer>
    </documentation>
    <category>integration</category>
    <website>https://github.com/alexdimarco/nextcloud-google-sync</website>
    <bugs>https://github.com/alexdimarco/nextcloud-google-sync/issues</bugs>
    <screenshot>https://github.com/MarcelRobitaille/nextcloud_google_synchronization/raw/master/img/screenshot1.jpg</screenshot>
    <dependencies>
        <nextcloud min-version="32" max-version="33"/>
    </dependencies>
    <settings>
        <admin>OCA\CalendarBridge\Settings\Admin</admin>
        <admin-section>OCA\CalendarBridge\Settings\AdminSection</admin-section>
        <personal>OCA\CalendarBridge\Settings\Personal</personal>
        <personal-section>OCA\CalendarBridge\Settings\PersonalSection</personal-section>
    </settings>
</info>
